// フォント定義
// MS系列が利用できない環境のために、IPAやNoto、Harano Aji(MS互換)をフォールバックに設定
#let font-mincho = ("Times New Roman", "MS Mincho", "MS PMincho", "Harano Aji Mincho", "Noto Serif CJK JP", "IPAMincho")
#let font-gothic = ("MS Gothic", "MS PGothic", "Harano Aji Gothic", "Noto Sans CJK JP", "IPAGothic")

// ページ設定 (A4, 余白20mm)
#set page(
  paper: "a4",
  margin: (x: 20mm, y: 20mm),
  numbering: "1", // ページ番号を表示
)

// テキストの基本設定
// 本文: MS P明朝 (10.5pt), 英数字: Times New Roman (10.5pt)
#set text(
  font: font-mincho,
  size: 10.5pt,
  lang: "ja",
)

// 段落設定
// 両端揃え (justify: true)
// 行頭インデント (first-line-indent: 1em)
// 行間 (leading): 50行/ページに近づけるため、標準よりやや狭める(0.65em程度)
#set par(
  justify: true,
  first-line-indent: 1em,
  leading: 0.65em,
)

// 見出しの設定
// MS Pゴシック, 太字, 10.5pt
#set heading(numbering: "1. ")
#show heading: it => [
  #set text(font: font-gothic, weight: "bold", size: 10.5pt)
  #set par(first-line-indent: 0em) // 見出しはインデントしない
  #block(above: 1.5em, below: 0.8em)[
    // 見出し番号と本文を表示
    #counter(heading).display() #it.body
  ]
]

